# Copy to .env and fill in. .env is gitignored -- never commit real values.

# https://www.last.fm/api/accounts -- API key only.
# The shared secret is a write credential and is NOT needed to read history.
LASTFM_API_KEY=
LASTFM_USER=

# https://developer.spotify.com/dashboard -- dogfooding only.
# Dev mode caps at 5 allowlisted users, so this can never ship (see TRD 4).
# Use the PKCE flow: Client ID only, no secret in a distributed binary.
SPOTIFY_CLIENT_ID=

# https://listenbrainz.org/settings/ -- the shipping source (CC0, no
# commercial restriction). Read endpoints need no token; the token is only for
# submitting listens and for reading a private account.
# Sent as a header:  Authorization: Token <value>
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=

# MusicBrainz. Reads (release lookup, tracklists, Cover Art Archive) need NO
# auth at all -- just a real User-Agent and <=1 request/second.
# The digest token from https://musicbrainz.org/account/applications is only
# for submitting edits, which this app never does. Deadwax does not need it.
MUSICBRAINZ_USER=
MUSICBRAINZ_TOKEN=
# Required on every MusicBrainz request or you get rate-limited/blocked:
MUSICBRAINZ_UA=Deadwax/0.1 ( your-email@example.com )

node_modules/

# Secrets. Never commit, never open.
.env
.env.local

# Your own listening history with embedded album art. Never publish: GitHub
# Pages serves the whole branch tree, so anything tracked here is public.
deadwax-data.js

# Everything under scripts/verify/ writes its screenshots beside itself.
# Regenerate them by running the script; do not track the output.
*.png
!favicon-*.png
!apple-touch-icon.png
!docs/*.png

# Build output and the app's own working files.
src-tauri/target/
dist/

# The listen log. Same rule as scripts/smtc/dump/, which is where most of it
# came from: this is your actual listening, track by track, with timestamps.
deadwax.db
src-tauri/deadwax.db
src-tauri/deadwax.db-wal
src-tauri/deadwax.db-shm

# Page exceptions, captured off the webview. Carries track names.
src-tauri/webview.log

# Album covers pulled off SMTC while playing. Copyrighted artwork, keyed to one
# person's listening -- exactly what deadwax-data.js is kept out for. The *.png
# rule below catches most of these; this catches the JPEGs too and says why.
src-tauri/art/

# ...but the app's own icons must ship, or a fresh clone cannot build.
!src-tauri/icons/
!src-tauri/icons/*.png

# Tool caches.
.impeccable/hook.cache.json

# Internal strategy: pricing, competitor analysis, sizing. Kept on disk, never
# published -- a public repo would hand these to anyone who clones it.
docs/PRD.md
docs/TRD.md
docs/BUSINESS.md
docs/PAIN-POINTS.md
docs/GUNS-LOL-TEARDOWN.md

# Generated by anatomy.js on every run; the script is the source.
scripts/verify/anatomy-sheet.html

# Raw SMTC captures. These are your actual listening, track by track, with
# timestamps. The scripts are public; their output never is.
scripts/smtc/dump/

# Cached lifetime listening history pulled for the release-fold research.
# Same rule: the script is public, your play counts are not.
scripts/fold/cache/
